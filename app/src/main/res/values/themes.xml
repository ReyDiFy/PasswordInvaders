<resources>
    <style name="Theme.PasswordInvader" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@drawable/bg_screen</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
    </style>
    <style name="Neon" />
    <style name="Neon.Title">
        <item name="android:textColor">@color/cyan</item>
        <item name="android:textSize">22sp</item>
        <item name="android:typeface">monospace</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="android:gravity">center</item>
    </style>
    <style name="Neon.Caption">
        <item name="android:textColor">@color/muted</item>
        <item name="android:textSize">9sp</item>
        <item name="android:typeface">monospace</item>
        <item name="android:letterSpacing">0.15</item>
        <item name="android:gravity">center</item>
    </style>
    <style name="Neon.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:background">@drawable/btn_cyan</item>
        <item name="android:textColor">@color/cyan</item>
        <item name="android:textSize">12sp</item>
        <item name="android:typeface">monospace</item>
        <item name="android:letterSpacing">0.1</item>
    </style>
    <style name="Key">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">5dp</item>
        <item name="android:background">@drawable/key_bg</item>
        <item name="android:textColor">@color/cyan</item>
        <item name="android:textSize">13sp</item>
        <item name="android:typeface">monospace</item>
        <item name="android:padding">0dp</item>
    </style>
</resources>
